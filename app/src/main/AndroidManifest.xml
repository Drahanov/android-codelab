<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Map tiles -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.sap.codelab.presentation.home.Home"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.sap.codelab.presentation.create.CreateMemo"
            android:exported="false"
            android:label="@string/new_memo"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sap.codelab.presentation.detail.ViewMemo"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sap.codelab.presentation.picklocation.PickLocation"
            android:exported="false"
            android:label="@string/pick_location"
            android:theme="@style/AppTheme.NoActionBar" />
    </application>

</manifest>